# ==============================================================================
# TruthLens Environment Variables (ZERO-COST CONFIGURATION)
# ==============================================================================

# Database
POSTGRES_USER=truthlens
POSTGRES_PASSWORD=truthlens_pass
POSTGRES_DB=truthlens
DATABASE_URL=postgresql://truthlens:truthlens_pass@localhost:5432/truthlens

# Redis
REDIS_URL=redis://localhost:6379/0

# Authentication
# Run `openssl rand -hex 32` to generate a secure secret
JWT_SECRET=super_secret_development_key
JWT_REFRESH_SECRET=super_secret_development_refresh_key
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# AI & Fact-Checking (Local/Zero-Cost Default)
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3:8b # Recommended for 16GB+ RAM. Use qwen2:0.5b or phi3:mini for low RAM.

EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text

# Search Engine (Local/Zero-Cost Default)
SEARCH_PROVIDER=searxng
SEARXNG_BASE_URL=http://localhost:8080/

# Storage
STORAGE_PROVIDER=local
STORAGE_BUCKET=./storage

# Frontend/Backend URLs
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000

# Feature Flags
DEMO_MODE=false
