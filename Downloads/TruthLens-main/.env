# ==============================================================================
# TruthLens Environment Variables (ZERO-COST CONFIGURATION)
# ==============================================================================

# Database (SQLite for zero-configuration local use)
DATABASE_URL=sqlite:///./truthlens.db

# Redis (optional, local in-memory fallback enabled if offline)
REDIS_URL=redis://localhost:6379/0

# Authentication
JWT_SECRET=super_secret_development_key
JWT_REFRESH_SECRET=super_secret_development_refresh_key
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# AI & Fact-Checking (Local/Zero-Cost Default)
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3:8b

EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text

# Search Engine (Local/Zero-Cost Default)
SEARCH_PROVIDER=searxng
SEARXNG_BASE_URL=http://localhost:8080/

# Storage
STORAGE_PROVIDER=local
STORAGE_BUCKET=./storage

# Frontend/Backend URLs
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000

# Feature Flags
DEMO_MODE=false
